# =========================
# APPLICATION
# =========================
SPRING_PROFILES_ACTIVE=local

# =========================
# DATABASE
# =========================
DB_URL=jdbc:postgresql://localhost:5432/scheduler
DB_USERNAME=admin
DB_PASSWORD=admin_macbook
DB_POOL_MIN_IDLE=2
DB_POOL_MAX_SIZE=10

# =========================
# KAFKA
# =========================
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# =========================
# SERVER
# =========================
SERVER_PORT=9002

# =========================
# CENTRALIZED SCHEDULER CONFIG
# =========================
SCHEDULER_ENABLED=true
SCHEDULER_POLL_INTERVAL=PT5S
SCHEDULER_EXECUTION_TIMEOUT=PT1H
SCHEDULER_CLAIM_BATCH_SIZE=20
SCHEDULER_MAX_PARALLELISM=50
SCHEDULER_HTTP_CONNECT_TIMEOUT=PT5S
SCHEDULER_HTTP_READ_TIMEOUT=PT30S
SCHEDULER_HTTP_MAX_READ_TIMEOUT=PT10M
SCHEDULER_ALLOWED_HOSTS=
SCHEDULER_HISTORY_MAX_RANGE=P31D
THRESHOLD_ALERT_ENABLED=true
CENTRALIZED_ALERT_URL=http://localhost:9001/api/v1/alert
THRESHOLD_ALERT_SENDER_EMAIL=scheduler@example.com
THRESHOLD_ALERT_SENDER_NAME=Centralized Scheduler
THRESHOLD_ALERT_RECIPIENTS=ops@example.com
THRESHOLD_ALERT_AUTHORIZATION_HEADER=
THRESHOLD_ALERT_TIMEOUT=PT10S
SCHEDULER_ERROR_ALERT_ENABLED=true
SCHEDULER_ERROR_ALERT_SENDER_EMAIL=scheduler@example.com
SCHEDULER_ERROR_ALERT_SENDER_NAME=Centralized Scheduler
SCHEDULER_ERROR_ALERT_RECIPIENTS=ops@example.com
SCHEDULER_ERROR_ALERT_AUTHORIZATION_HEADER=
SCHEDULER_ERROR_ALERT_TIMEOUT=PT10S
SCHEDULER_AUDIT_ENABLED=true
SCHEDULER_AUDIT_TOPIC=centralized-audit.requested
SCHEDULER_AUDIT_SOURCE_SYSTEM=SCHEDULER-SERVICE
SCHEDULER_AUDIT_FALLBACK_ACTOR_ID=scheduler-service

# =========================
# SHARED SDK
# =========================
APP_TIMEZONE=UTC
SDK_SECURITY_ENABLED=true
SDK_METHOD_SECURITY_ENABLED=true
SDK_CORS_ENABLED=false
OAUTH2_ISSUER_URI=http://localhost:9005
JWT_PRINCIPAL_ATTRIBUTE=username

# =========================
# LOGGING
# =========================
LOG_LEVEL_ROOT=DEBUG
LOG_LEVEL_APPLICATION=DEBUG
